# App Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-super-secret-key-32-chars-minimum-random!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with pgvector & pg_trgm)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=memoledger
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memoledger

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 Object Storage (MinIO)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=memoledger-memos
S3_USE_SSL=False

# Vision LLM Provider
# Options: "gemini", "openai", "anthropic", "mock"
VISION_LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse / OpenTelemetry
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
